# The lab's one config file. Copy it to lab.env (git-ignored), fill in your own values, then
# `source harness/lab_env.sh` in every shell that runs the lab. lab_env.sh reads lab.env and
# derives everything else (service account email, registry, gcloud config directory, kubeconfig).
# lab_env.sh sources this file as shell, so treat it as code you trust: keep it to KEY=value lines
# ($HOME and earlier variables expand). Anything left unset takes the default shown here.

# --- Your Google Cloud project (required) --------------------------------------------------------
LAB_PROJECT=your-project-id
# Optional. Scripts that need the project number look it up at runtime with
#   gcloud projects describe "$LAB_PROJECT" --format='value(projectNumber)'
# Set it here only to skip that lookup.
#LAB_PROJECT_NUMBER=
# Where the clusters run. Every cluster, node pool and VM goes in LAB_ZONE, which must sit in
# LAB_REGION (lab_env.sh refuses a mismatch). Change the zone if it's out of capacity for the
# machine types; the SSD quota and the registry follow the region.
LAB_REGION=us-central1
LAB_ZONE=us-central1-a

# --- Cluster and identity ------------------------------------------------------------------------
# The Substrate cluster's name, as you answer the installer's cluster step (infra/substrate/INSTALL.md).
LAB_CLUSTER=lab-substrate
# The agent's Google service account (create it first; its one grant is roles/aiplatform.user on
# LAB_PROJECT). The email is derived: $LAB_AGENT_SA_NAME@$LAB_PROJECT.iam.gserviceaccount.com
LAB_AGENT_SA_NAME=lab-agent
# Your workstation's egress address as a /32, for the hardened profile's authorized networks.
#OPERATOR_CIDR=203.0.113.7/32

# --- Model ---------------------------------------------------------------------------------------
LAB_MODEL=gemini-4-hydrogen-medium
GOOGLE_CLOUD_LOCATION=global

# --- Images (fill after you build and push them; pin by digest) ----------------------------------
# The registry is derived: $LAB_REGION-docker.pkg.dev/$LAB_PROJECT/lab-images (Artifact Registry
# repository lab-images, created by you). Push each image there and paste the digest reference.
#   agent/Dockerfile.agent           -> LAB_AGENT_IMAGE
#   agent/Dockerfile.actor           -> LAB_ACTOR_IMAGE
#   infra/executor/image/Dockerfile  -> LAB_EXECUTOR_IMAGE
#   infra/substrate/team-lcb/Dockerfile -> LCB_ACTOR_IMAGE
LAB_AGENT_IMAGE=
LAB_ACTOR_IMAGE=
LAB_EXECUTOR_IMAGE=
LCB_ACTOR_IMAGE=
# Google's benchmark runner image, built by `harness/google_bench.py build`.
# Default: $LAB_REGISTRY/locust-test:v1.0.1
#LAB_BENCH_IMAGE=

# --- Agent Substrate install ---------------------------------------------------------------------
# The snapshot bucket the Substrate installer prints in its exit summary (needed for teardown).
SUBSTRATE_BUCKET=

# --- Local checkouts and tools -------------------------------------------------------------------
# Where the pinned upstream checkouts live. Each path defaults under LAB_SRC.
LAB_SRC=$HOME/lab-src
#SUBSTRATE_DIR=$HOME/lab-src/substrate          # agent-substrate/substrate at v1.0.1
#SUBSTRATE_GKE_DIR=$HOME/lab-src/substrate-gke  # ai-on-gke/substrate-gke at the pinned commit
#AX_DIR=$HOME/lab-src/ax                        # google/ax at v0.4.0-rc.1, `go install ./cmd/ax`
#AX_BIN=$HOME/lab-src/ax/bin/ax
# The simulated application under test (clinicbench). Not needed to run anything here: the case trees
# ship in baselines/. Only validator/build_baseline.py reads it, to rebuild a tree from clinicbench history.
#CLINICBENCH_DIR=$HOME/lab-src/clinicbench
# Team two's benchmark (LoopControlBench), only for harness/lcb_team.py.
#LCB_DIR=$HOME/lab-src/loopcontrolbench

# --- Python ----------------------------------------------------------------------------------------
# The interpreter that runs the harness scripts.
LAB_PYTHON=python3
# An interpreter with google-auth installed, for the token minters (agent/mint_token.py,
# harness/token_secret.py) and the scripts that call them. Defaults to LAB_PYTHON.
#GOOGLE_AUTH_PY=$HOME/.venvs/lab/bin/python

# --- gcloud ----------------------------------------------------------------------------------------
# The lab's own gcloud config directory, so your global gcloud and ADC defaults are untouched.
# Default: $HOME/.config/gcloud-$LAB_PROJECT (the kubeconfig lives inside it).
#LAB_GCLOUD_CONFIG=
# Directories prepended to PATH in lab shells only, colon-separated. For example the Homebrew
# gcloud SDK, which carries the GKE auth plugin:
#LAB_EXTRA_PATH=/opt/homebrew/share/google-cloud-sdk/bin
# A directory holding only a `bash` link to bash 4.4 or later, put first on PATH for Google's
# benchmark scripts (macOS ships 3.2). Default: $LAB_GCLOUD_CONFIG/bash5-bin, used if it exists.
#LAB_BASH5_DIR=
