# Local config and credentials: never committed.
lab.env
*.kubeconfig
kubeconfig*
token.json
token.json.tmp
*.token
forge/.forge.json

# Run output and caches.
runs/
__pycache__/
*.pyc
*.lock

# Vendored binaries (agy builds): fetched by each user, not redistributed.
agent/vendor/
infra/vendor/

# The placeholder check's throwaway certificates.
harness/placeholder_check/ca/
harness/placeholder_check/srv/*.pem
harness/placeholder_check/srv/*.key
harness/placeholder_check/srv/*.csr
harness/placeholder_check/srv/*.srl
