   ],
   "symbols": [
    "clinicbench.policy.PatientPolicy.answer",
    "clinicbench.policy.PatientPolicy.respond",
    "clinicbench.voice.Voice._prop",
    "clinicbench.voice.Voice.say"
   ],
   "attribution": null,
   "cause": "When a patient with no target_appt (e.g. booking-only) is asked for target_appt, PatientPolicy.answer emits a prop part with aff=[] and PatientPolicy.respond marks act='answer'. Voice._prop returns '' for an empty prop, causing Voice.say to output an empty reply."
  },
  {
   "kind": "fix",
   "files": [
    "clinicbench/policy.py"
   ],
   "symbols": [
    "clinicbench.policy.PatientPolicy.answer",
    "clinicbench.policy.PatientPolicy.respond"
   ],
   "attribution": null,
   "cause": "When asked about target_appt for a patient with no target appointment, PatientPolicy.answer emits a prop part with aff=[] and PatientPolicy.respond sets act='answer', which Voice._prop renders as an empty string."
  },
  {
   "kind": "fix",
   "files": [
    "clinicbench/policy.py",
    "clinicbench/voice.py"
   ],
   "symbols": [
    "clinicbench.policy.PatientPolicy.answer",
    "clinicbench.policy.PatientPolicy.respond",
    "clinicbench.voice.Voice._prop",
    "clinicbench.voice.Voice.say"
   ],
   "attribution": null,
   "cause": "When asked about target_appt (or any proposition with no affirmed or excluded values in truth, such as slot or doctor on non-booking truths), PatientPolicy.answer emits a prop part with empty aff/exc while PatientPolicy.respond sets act to 'answer' without a fallback. Voice._prop returns '' for empty prop parts and Voice.say omits empty strings, producing a blank reply."
  }
